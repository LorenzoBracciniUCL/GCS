           "\[CapitalOmega]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"2", "^", "Nqubits"}], ",", 
      RowBox[{"2", "^", "Nqubits"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputePhiJKUnitaryForce", "[", 
    RowBox[{
    "nmodes_", ",", "r0t_", ",", "r0_", ",", "rJt_", ",", "rJ_", ",", "rKt_", 
     ",", "rK_", ",", "Hm_", ",", "Hq0Array_", ",", "Jlabels_", ",", 
     "Klabels_", ",", "time_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"phi1", ",", "phi2", ",", "phi3"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phi1", "=", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"rJ", "-", "rK"}], "]"}], ".", "\[CapitalOmega]", ".", 
         RowBox[{"(", 
          RowBox[{"r0t", "-", "r0"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phi2", "=", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
