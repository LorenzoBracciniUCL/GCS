         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"rJ", "-", "rK"}], "]"}], ".", "Hm", ".", 
           RowBox[{"(", 
            RowBox[{"rJ", "+", "rK"}], ")"}]}], "-", 
          RowBox[{
           RowBox[{"Transpose", "[", "Hq0Array", "]"}], ".", 
