    RowBox[{
     RowBox[{"sigmat", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Sm", ".", "sigma0", ".", 
        RowBox[{"Transpose", "[", "Sm", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}], ",", "sigmat"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "Nqubits"}], ",", 
         RowBox[{"2", "^", "Nqubits"}]}], "}"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComputeRJKUnitaryForce", "[", 
   RowBox[{
   "nmodes_", ",", "r0t_", ",", "sigmat_", ",", "rJt_", ",", "rJ_", ",", 
