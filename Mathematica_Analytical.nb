  "\[IndentingNewLine]", 
  RowBox[{"r0t", "-", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"rJt", "-", "rJ", "+", "rKt", "-", "rK"}], ")"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"I", "/", "2"}], ")"}], " ", 
    RowBox[{"sigmat", ".", "\[CapitalOmega]", ".", 
     RowBox[{"(", 
      RowBox[{"rJt", "-", "rJ", "-", "rKt", "+", "rK"}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComputeRMatrixUnitaryForce", "[", 
   RowBox[{
   "Nqubits_", ",", "nmodes_", ",", "sigmat_", ",", "Sm_", ",", " ", "Hminv_",
     ",", "rhamArray_", ",", " ", "r0t_", ",", "\[CapitalOmega]_"}], "]"}], ":=",
   " ", 
  RowBox[{"Array", "[", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"j", ",", "k"}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rJ", ",", " ", "rK"}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rJ", "=", "  ", 
            RowBox[{"ComputeTildeRJ", "[", 
             RowBox[{"Nqubits", ",", 
              RowBox[{"ExtractQubitLabelsArray", "[", 
               RowBox[{"Nqubits", ",", "j"}], "]"}], ",", "Hminv", ",", 
              "rhamArray"}], "]"}]}], ",", " ", 
           RowBox[{"rK", "=", "  ", 
            RowBox[{"ComputeTildeRJ", "[", 
             RowBox[{"Nqubits", ",", 
              RowBox[{"ExtractQubitLabelsArray", "[", 
               RowBox[{"Nqubits", ",", "k"}], "]"}], ",", "Hminv", ",", 
              "rhamArray"}], "]"}]}]}], "}"}], ";", 
         RowBox[{"ComputeRJKUnitaryForce", "[", 
          RowBox[{"nmodes", ",", "r0t", ",", "sigmat", ",", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{"Sm", ".", "rJ"}], "]"}], ",", "rJ", ",", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{"Sm", ".", "rK"}], "]"}], ",", "rK", ",", 
           "\[CapitalOmega]"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"2", "^", "Nqubits"}], ",", 
      RowBox[{"2", "^", "Nqubits"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeCJKUnitaryForce", "[", 
    RowBox[{
    "nmodes_", ",", "sigmat_", ",", "rJt_", ",", "rJ_", ",", "rKt_", ",", 
     "rK_", ",", "\[CapitalOmega]_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"1", "/", "4"}], " ", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"rJt", "-", "rJ", "-", "rKt", "+", "rK"}], "]"}], ".", 
       RowBox[{"Transpose", "[", "\[CapitalOmega]", "]"}], ".", "sigmat", ".",
        "\[CapitalOmega]", ".", 
       RowBox[{"(", 
        RowBox[{"rJt", "-", "rJ", "-", "rKt", "+", "rK"}], ")"}]}]}], "]"}], "[", 
