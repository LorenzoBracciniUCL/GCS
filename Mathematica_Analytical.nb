Cell[BoxData[{
 RowBox[{
  RowBox[{"ExtractQubitLabelsArray", "[", 
   RowBox[{"Nqubits_", ",", "index_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{"IntegerDigits", "[", 
     RowBox[{
      RowBox[{"index", " ", "-", " ", "1"}], ",", "2", ",", "Nqubits"}], 
     "]"}]}], "-", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComputeTildeRJ", "[", 
   RowBox[{"Nqubits_", ",", "Jlabels_", ",", "Hminv_", ",", "rhamArray_"}], 
   "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Hminv", ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"rhamArray", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Jlabels", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"rhamArray", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Nqubits"}], "}"}]}], "]"}]}], ")"}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"ComputeSigmaMatrixUnitaryForce", "[", 
   RowBox[{
   "Nqubits_", ",", "nmodes_", ",", "sigma0_", ",", "Sm_", ",", 
    "\[CapitalOmega]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
